# Copie este arquivo para ".env" e preencha com as suas chaves.
# O arquivo ".env" NUNCA deve ir para o git (já está no .gitignore).
# No Streamlit Community Cloud, use App Settings -> Secrets (formato TOML) com os mesmos nomes.
# Cada provedor aceita de 1 até 3 chaves gratuitas; o pool alterna entre elas (round-robin).
# Para testar localmente com uma única chave, também vale GROQ_API_KEY e GOOGLE_API_KEY (no singular).

# Chaves Groq para Nós 1 e 3 (Guardrails - openai/gpt-oss-120b)
GROQ_API_KEY_1="gsk_..."
GROQ_API_KEY_2="gsk_..."
GROQ_API_KEY_3="gsk_..."

# Chaves Google AI Studio (Free Tier) para Nó 2 (Agente Principal - gemini-2.5-flash)
GEMINI_API_KEY_1="AIza..."
GEMINI_API_KEY_2="AIza..."
GEMINI_API_KEY_3="AIza..."
